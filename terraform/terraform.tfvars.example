# The default AWS CLI profile is cloudnative-study.
# Override aws_profile only when you need a different local profile.
# aws_profile = "cloudnative-study"

# Direct access keys are still supported when aws_profile is set to "".
aws_access_key = "여기에_ACCESS_KEY_입력"
aws_secret_key = "여기에_SECRET_KEY_입력"

aws_region = "ap-northeast-2"

# Default team key path. Each developer should place the shared public key here.
# k8s_public_key_path = "~/.ssh/k8s-key.pub"
# k8s_public_key = "ssh-ed25519 ..."

github_repository_owner = "asdqwce"
github_repository_name  = "cloudnative_study"

# Release branches and Git tags that may assume the OIDC role.
github_actions_release_branches = ["release/dev", "release/prod"]
github_actions_tag_pattern      = "v*"
github_actions_role_name        = "github-actions-cloudnative-release"

# Terraform appends the current workspace to this base prefix.
# Example workspace dang-dev -> cloudnative-study-dang-dev/patient-service
# ecr_repository_prefix = "cloudnative-study"

# Decision point: add future Kong/Python services here after their manifests and Dockerfiles land on main.
ecr_service_repositories = [
  "auth-service",
  "patient-service",
  "appointment-service",
  "prescription-service",
  "notification-service",
  "dashboard",
]
