#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
script_path="${repo_root}/scripts/security/pre-push.sh"

if [ ! -x "${script_path}" ]; then
  printf '%s\n' "pre-push runner를 실행할 수 없습니다: ${script_path}" >&2
  printf '%s\n' "먼저 실행하세요: make install" >&2
  exit 127
fi

exec sh "${script_path}"
