{
  "info": {
    "_postman_id": "64a8820f-2a82-4f02-bfc2-900ea3f78f38",
    "name": "MediKong Gateway E2E",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create patient as staff",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{staffToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"E2E Patient\",\"birthDate\":\"1990-01-01\",\"gender\":\"F\",\"contact\":\"010-0000-0000\",\"primaryDoctorId\":10,\"allergies\":\"none\",\"medicationWarnings\":\"none\"}"
        },
        "url": "{{baseUrl}}/patients"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('patient is created', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.id).to.be.a('number');",
              "  pm.environment.set('patientId', String(body.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Request appointment as patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"doctorId\":10,\"appointmentAt\":\"2026-05-20T10:00:00\",\"reason\":\"headache\"}"
        },
        "url": "{{baseUrl}}/appointments"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('appointment is requested', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql('REQUESTED');",
              "  pm.environment.set('appointmentId', String(body.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Confirm appointment as doctor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "url": "{{baseUrl}}/appointments/{{appointmentId}}/confirm"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('appointment is confirmed', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('CONFIRMED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Issue prescription as doctor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{doctorToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"patientId\":{{patientId}},\"doctorId\":10,\"medicationName\":\"Amoxicillin\",\"dosage\":\"500mg\",\"instructions\":\"after meals\"}"
        },
        "url": "{{baseUrl}}/prescriptions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('prescription is issued', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.patientId).to.eql(Number(pm.environment.get('patientId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List notifications as patient",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "url": "{{baseUrl}}/notifications"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('notifications endpoint is available', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List prescriptions as patient",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{patientToken}}"
          }
        ],
        "url": "{{baseUrl}}/prescriptions"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('patient prescriptions are returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
